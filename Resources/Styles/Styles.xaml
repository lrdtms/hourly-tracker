<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Ground}" />
    </Style>

    <!-- Type: Instrument Sans for everything, Instrument Serif for the greeting/title only. -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Greeting" TargetType="Label">
        <Setter Property="FontFamily" Value="Serif" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="LineHeight" Value="1.02" />
    </Style>
    <Style x:Key="Section" TargetType="Label">
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Kpi" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="32" />
    </Style>
    <Style x:Key="Lead" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>
    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Small" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Panels: one tonal layer, no shadow, no hairline box. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Ground}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,16,14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: pills. Primary = accent fill; Tonal = quiet grey; Quiet = text only. -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
    </Style>
    <Style x:Key="Tonal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDeep}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style x:Key="Quiet" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Accent}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>

    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource Border}" />
    </Style>
</ResourceDictionary>
