<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens: "Editorial greeting" app style (taste-skill), one teal accent, tonal panels. -->
    <Color x:Key="Ground">#FFFFFF</Color>
    <Color x:Key="Surface">#F9F9F9</Color>
    <Color x:Key="SurfaceDeep">#F0F0ED</Color>
    <Color x:Key="Border">#EAEAEA</Color>
    <Color x:Key="Rule">#F3F3F3</Color>
    <Color x:Key="Control">#D9D9D6</Color>
    <Color x:Key="Text">#1F201D</Color>
    <Color x:Key="Muted">#636361</Color>
    <Color x:Key="Accent">#1B6E66</Color>
    <Color x:Key="AccentSoft">#E3F0EE</Color>
    <Color x:Key="Negative">#B42318</Color>
    <Color x:Key="PillOkBg">#DCFAE5</Color>
    <Color x:Key="PillOkInk">#04250E</Color>
    <Color x:Key="PillWarnBg">#FFFBEB</Color>
    <Color x:Key="PillWarnInk">#92400E</Color>

    <!-- Chart categorical slots (validated with dataviz validate_palette.js, adjacent pairs). -->
    <Color x:Key="Series1">#2A78D6</Color>
    <Color x:Key="Series2">#EB6834</Color>
    <Color x:Key="Series3">#1BAF7A</Color>
    <Color x:Key="Series4">#EDA100</Color>
    <Color x:Key="Series5">#E87BA4</Color>
    <Color x:Key="SeriesOther">#8C8C88</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
