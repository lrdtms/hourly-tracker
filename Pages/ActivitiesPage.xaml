<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HourlyTracker.ViewModels"
             xmlns:models="clr-namespace:HourlyTracker.Models"
             x:Class="HourlyTracker.Pages.ActivitiesPage"
             x:DataType="vm:ActivitiesViewModel"
             Shell.NavBarIsVisible="False"
             Title="Activities">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="Activities" Style="{StaticResource Greeting}" />
                <Label Text="The things you usually do. They become the choices in every check-in."
                       Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Panel}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border BackgroundColor="White" StrokeThickness="0" Padding="16,0" HeightRequest="44">
                            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                            <Entry Placeholder="Work, Gym, Cooking…" Text="{Binding NewName}"
                                   ReturnType="Done" ReturnCommand="{Binding AddCommand}" VerticalOptions="Center" />
                        </Border>
                        <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" />
                    </Grid>
                    <Label Text="{Binding Message}" Style="{StaticResource MutedText}" TextColor="{StaticResource Negative}"
                           IsVisible="{Binding HasMessage}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout>
                    <Label Text="{Binding CountText}" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <Label Text="Nothing here yet. Add your first activity above."
                           Style="{StaticResource MutedText}" IsVisible="{Binding IsEmpty}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityType">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource Hairline}" />
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                        <Label Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Remove" Style="{StaticResource Quiet}"
                                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:ActivitiesViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
