<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HourlyTracker.ViewModels"
             xmlns:ctl="clr-namespace:HourlyTracker.Controls"
             x:Class="HourlyTracker.Pages.TodayPage"
             x:DataType="vm:TodayViewModel"
             Shell.NavBarIsVisible="False"
             Title="Today">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="16">

            <!-- Greeting is the h1. The line under it is today's one fact. -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Greeting}" Style="{StaticResource Greeting}" />
                <Label Text="{Binding Finding}" Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <!-- Day navigation -->
            <HorizontalStackLayout Spacing="4">
                <Button Text="‹" Style="{StaticResource Tonal}" WidthRequest="44" Padding="0"
                        Command="{Binding PreviousDayCommand}" />
                <Label Text="{Binding DayLabel}" Style="{StaticResource Section}" VerticalOptions="Center"
                       WidthRequest="110" HorizontalTextAlignment="Center" />
                <Button Text="›" Style="{StaticResource Tonal}" WidthRequest="44" Padding="0"
                        Command="{Binding NextDayCommand}" IsEnabled="{Binding CanGoNext}" />
            </HorizontalStackLayout>

            <!-- First run: nothing to pick from yet -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding HasActivities, Converter={StaticResource Not}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Start with the things you usually do" Style="{StaticResource Section}" />
                    <Label Text="Add your activities once, then each check-in is a single tap."
                           Style="{StaticResource MutedText}" />
                    <Button Text="Add activities" Command="{Binding OpenActivitiesCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- The day as check-in slots -->
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding StripCaption}" Style="{StaticResource Section}" />
                    <ctl:DayStripView x:Name="Strip" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding StripStart}" Style="{StaticResource Small}" />
                        <Label Grid.Column="1" Text="{Binding StripEnd}" Style="{StaticResource Small}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Where it went -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Where it went" Style="{StaticResource Section}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Totals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityTotal">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" />
                                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource MutedText}" />
                                    </Grid>
                                    <ctl:BarView Fraction="{Binding Fraction}" BarColor="{Binding BarColor}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Log -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Log" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryItem">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource Hairline}" />
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,12" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding TimeText}" Style="{StaticResource Small}" />
                                            <Label Text="{Binding Name}" Style="{StaticResource Section}" FontSize="16" />
                                            <Label Text="{Binding Comment}" IsVisible="{Binding HasComment}"
                                                   Style="{StaticResource MutedText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                                            <Label Text="{Binding Duration}" HorizontalTextAlignment="End" />
                                            <Button Text="Remove" Style="{StaticResource Quiet}" FontSize="12" Padding="0"
                                                    HorizontalOptions="End"
                                                    Command="{Binding DeleteEntryCommand, Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
